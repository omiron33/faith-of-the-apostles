"lines": [
{
"text": "Come and see.",
"start": 12.321,
"end": 13.641
},
{
"text": "Come and see.",
"start": 19.561,
"end": 20.801
},
{
"text": "Old roads.",
"start": 27.522,
"end": 28.242
},
{
"text": "Old prayers.",
"start": 31.162,
"end": 32.062
},
{
"text": "One flame",
"start": 34.802,
"end": 35.623
},
{
"text": "still burning there.",
"start": 37.323,
"end": 39.083
},
{
"text": "He called the Twelve beside the sea,",
"start": 41.483,
"end": 44.103
},
{
"text": "said, \"Follow Me, and follow faithfully.\"",
"start": 44.863,
"end": 47.523
},
{
"text": "They crossed the world with scars to show,",
"start": 48.743,
"end": 51.484
},
{
"text": "planting the Church wherever they'd go.",
"start": 52.344,
"end": 55.204
},
{
"text": "Hand upon shoulder,",
"start": 56.024,
"end": 57.484
},
{
"text": "prayer upon prayer,",
"start": 57.584,
"end": 59.044
},
{
"text": "bishop to bishop,",
"start": 59.644,
"end": 60.624
},
{
"text": "the fire stayed there.",
"start": 60.764,
"end": 62.604
},
{
"text": "Through kings and wars,",
"start": 63.004,
"end": 64.265
},
{
"text": "through blood and stone,",
"start": 64.805,
"end": 66.205
},
{
"text": "the faith was handed,",
"start": 66.645,
"end": 68.225
},
{
"text": "never alone.",
"start": 68.705,
"end": 69.625
},
{
"text": "Not dug from ruins,",
"start": 70.045,
"end": 71.485
},
{
"text": "not built anew\u2014",
"start": 71.605,
"end": 73.145
},
{
"text": "what they received,",
"start": 73.645,
"end": 75.105
},
{
"text": "they carried through.",
"start": 75.445,
"end": 76.785
},
{
"text": "One Lord.",
"start": 77.445,
"end": 78.106
},
{
"text": "One faith.",
"start": 78.346,
"end": 79.006
},
{
"text": "One baptism.",
"start": 79.126,
"end": 80.346
},
{
"text": "One flame",
"start": 81.046,
"end": 81.726
},
{
"text": "from hand to hand.",
"start": 81.806,
"end": 84.946
},
{
"text": "THIS IS THE FAITH",
"start": 85.046,
"end": 85.946
},
{
"text": "OF THE APOSTLES.",
"start": 86.426,
"end": 87.786
},
{
"text": "THIS IS THE FAITH",
"start": 87.906,
"end": 89.826
},
{
"text": "OF THE FATHERS.",
"start": 90.026,
"end": 91.226
},
{
"text": "Ancient and living,",
"start": 92.307,
"end": 93.827
},
{
"text": "steady and true,",
"start": 93.907,
"end": 94.967
},
{
"text": "the road they walked",
"start": 95.587,
"end": 96.807
},
{
"text": "still carries us through.",
"start": 97.067,
"end": 98.767
},
{
"text": "Holy God,",
"start": 98.867,
"end": 99.907
},
{
"text": "Holy Mighty,",
"start": 99.947,
"end": 100.787
},
{
"text": "Holy Immortal\u2014",
"start": 101.287,
"end": 102.467
},
{
"text": "HAVE MERCY ON US.",
"start": 102.667,
"end": 104.367
},
{
"text": "Holy God,",
"start": 106.248,
"end": 107.108
},
{
"text": "Holy Mighty,",
"start": 107.148,
"end": 108.088
},
{
"text": "Holy Immortal\u2014",
"start": 108.488,
"end": 109.728
},
{
"text": "HAVE MERCY ON US.",
"start": 109.968,
"end": 111.648
},
{
"text": "But distance grows",
"start": 113.668,
"end": 114.868
},
{
"text": "when brothers divide.",
"start": 115.468,
"end": 116.728
},
{
"text": "East on one shore,",
"start": 117.108,
"end": 118.548
},
{
"text": "West on the other side.",
"start": 118.608,
"end": 120.089
},
{
"text": "Different tongues.",
"start": 121.109,
"end": 121.989
},
{
"text": "Different thrones.",
"start": 122.929,
"end": 123.789
},
{
"text": "Old wounds deep",
"start": 124.409,
"end": 125.609
},
{
"text": "beneath old stones.",
"start": 125.829,
"end": 127.349
},
{
"text": "And year by year,",
"start": 128.109,
"end": 129.169
},
{
"text": "the tension climbed,",
"start": 129.889,
"end": 131.229
},
{
"text": "until the break",
"start": 131.269,
"end": 132.149
},
{
"text": "in ten-fifty-four arrived.",
"start": 132.189,
"end": 134.83
},
{
"text": "Rome and the East",
"start": 135.55,
"end": 136.75
},
{
"text": "no longer one,",
"start": 136.87,
"end": 138.03
},
{
"text": "a thousand small cracks",
"start": 138.49,
"end": 139.89
},
{
"text": "finally undone.",
"start": 140.05,
"end": 142.25
},
{
"text": "Not one cause.",
"start": 142.33,
"end": 143.67
},
{
"text": "Not one day.",
"start": 143.77,
"end": 145.41
},
{
"text": "But one word",
"start": 145.89,
"end": 147.23
},
{
"text": "still marks the way.",
"start": 147.36,
"end": 149.22
},
{
"text": "One word",
"start": 149.22,
"end": 150.3
},
{
"text": "at the edge of the flame.",
"start": 150.3,
"end": 152.14
},
{
"text": "One word",
"start": 152.14,
"end": 153.88
},
{
"text": "they still would name.",
"start": 153.88,
"end": 157.1
},
{
"text": "FILL-EE-OH-KWAY.",
"start": 157.1,
"end": 158.48
},
{
"text": "FILL-EE-OH-KWAY.",
"start": 164.16,
"end": 165.66
},
{
"text": "So East held fast",
"start": 171.312,
"end": 172.692
},
{
"text": "to the ancient Creed,",
"start": 173.072,
"end": 174.272
},
{
"text": "not chasing fashion,",
"start": 174.652,
"end": 176.333
},
{
"text": "not changing the seed.",
"start": 176.453,
"end": 177.813
},
{
"text": "Father, Son,",
"start": 178.653,
"end": 179.373
},
{
"text": "and Spirit adored,",
"start": 180.293,
"end": 181.413
},
{
"text": "one God confessed,",
"start": 181.973,
"end": 183.273
},
{
"text": "one risen Lord.",
"start": 183.773,
"end": 184.713
},
{
"text": "The councils spoke,",
"start": 185.653,
"end": 186.773
},
{
"text": "the bishops stood,",
"start": 187.453,
"end": 188.573
},
{
"text": "guarding the faith",
"start": 189.493,
"end": 190.434
},
{
"text": "as faithful men should.",
"start": 190.614,
"end": 191.974
},
{
"text": "And Mary bore",
"start": 192.894,
"end": 193.914
},
{
"text": "the eternal Word\u2014",
"start": 194.414,
"end": 195.554
},
{
"text": "Theotokos,",
"start": 196.654,
"end": 197.614
},
{
"text": "Mother of God.",
"start": 198.434,
"end": 199.634
},
{
"text": "Not because she made",
"start": 200.154,
"end": 201.554
},
{
"text": "the One above,",
"start": 201.614,
"end": 203.114
},
{
"text": "but because God",
"start": 203.594,
"end": 205.095
},
{
"text": "came down in love.",
"start": 205.155,
"end": 206.695
},
{
"text": "The Word took flesh.",
"start": 207.175,
"end": 208.555
},
{
"text": "The grave gave way.",
"start": 208.955,
"end": 210.355
},
{
"text": "And death itself",
"start": 210.795,
"end": 211.995
},
{
"text": "could not make Him stay.",
"start": 212.095,
"end": 214.095
},
{
"text": "THIS IS THE FAITH",
"start": 214.115,
"end": 215.815
},
{
"text": "OF THE APOSTLES.",
"start": 216.015,
"end": 217.395
},
{
"text": "THIS IS THE FAITH",
"start": 218.396,
"end": 219.436
},
{
"text": "OF THE FATHERS.",
"start": 219.636,
"end": 220.776
},
{
"text": "Ancient and living,",
"start": 221.856,
"end": 222.756
},
{
"text": "steady and true,",
"start": 223.436,
"end": 224.516
},
{
"text": "the road they walked",
"start": 225.156,
"end": 226.516
},
{
"text": "still carries us through.",
"start": 226.636,
"end": 228.296
},
{
"text": "Holy God,",
"start": 228.596,
"end": 229.396
},
{
"text": "Holy Mighty,",
"start": 229.416,
"end": 230.036
},
{
"text": "Holy Immortal\u2014",
"start": 230.896,
"end": 231.856
},
{
"text": "HAVE MERCY ON US.",
"start": 232.216,
"end": 233.997
},
{
"text": "Have mercy.",
"start": 236.517,
"end": 237.777
},
{
"text": "Have mercy.",
"start": 238.357,
"end": 239.397
},
{
"text": "Have mercy on us.",
"start": 239.537,
"end": 241.317
},
{
"text": "But why did He come?",
"start": 241.697,
"end": 244.937
},
{
"text": "Why take our frame?",
"start": 245.197,
"end": 246.598
},
{
"text": "Why step into sorrow,",
"start": 246.978,
"end": 248.418
},
{
"text": "suffering and shame?",
"start": 248.618,
"end": 250.238
},
{
"text": "Not only pardon.",
"start": 250.678,
"end": 252.198
},
{
"text": "Not only release.",
"start": 252.298,
"end": 253.818
},
{
"text": "He came to make",
"start": 254.338,
"end": 256.038
},
{
"text": "the broken complete.",
"start": 256.138,
"end": 257.578
},
{
"text": "Made in His image,",
"start": 258.178,
"end": 259.478
},
{
"text": "called toward His light,",
"start": 261.419,
"end": 263.279
},
{
"text": "drawn from the darkness,",
"start": 265.659,
"end": 273.419
}
],
